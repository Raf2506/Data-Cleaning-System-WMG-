{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/cards/**",
              "components/core/**",
              "components/disclosure/**",
              "components/forms/**",
              "components/media/**",
              "components/navigation/**",
              "ui_kits/invoice-cleaner/**",
              "ui_kits/storefront/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Anton|Inter|Noto Sans Arabic))/i]",
        "message": "Font not provided by the design system. Available: Anton, Inter, Noto Sans Arabic."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|fullWidth|iconLeft|iconRight|as|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, fullWidth, iconLeft, iconRight, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|onImage)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'onImage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|eyebrow|cta|ratio|image|imageNote|headlineColor|size|align|tone|style|key|ref|className|style|children)$/]",
        "message": "<CampaignTile> doesn't accept that prop. Declared props: headline, eyebrow, cta, ratio, image, imageNote, headlineColor, size, align, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignTile'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<CampaignTile> align must be one of 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryIconCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|image|imageNote|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CategoryIconCard> doesn't accept that prop. Declared props: label, image, imageNote, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclosureRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|variant|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<DisclosureRow> doesn't accept that prop. Declared props: label, children, variant, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclosureRow'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:detail|faq)$/]",
        "message": "<DisclosureRow> variant must be one of 'detail' | 'faq'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|count|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: children, active, count, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|options|key|ref|className|style|children)$/]",
        "message": "<FilterGroup> doesn't accept that prop. Declared props: title, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|size|iconSize|variant|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, label, size, iconSize, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|ghost|onImage|inverse)$/]",
        "message": "<IconButton> variant must be one of 'soft' | 'ghost' | 'onImage' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MemberBenefitCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|cta|ratio|image|imageNote|tone|style|key|ref|className|style|children)$/]",
        "message": "<MemberBenefitCard> doesn't accept that prop. Declared props: headline, cta, ratio, image, imageNote, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoStage'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|note|tone|children|style|key|ref|className|style|children)$/]",
        "message": "<PhotoStage> doesn't accept that prop. Declared props: src, alt, ratio, note, tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|wasPrice|discount|size|style|key|ref|className|style|children)$/]",
        "message": "<PriceRow> doesn't accept that prop. Declared props: price, wasPrice, discount, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceRow'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<PriceRow> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrimaryNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|items|active|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<PrimaryNav> doesn't accept that prop. Declared props: brand, items, active, onNavigate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|category|price|wasPrice|discount|badge|colors|colorCount|image|imageNote|ratio|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: name, category, price, wasPrice, discount, badge, colors, colorCount, image, imageNote, ratio, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|width|style|key|ref|className|style|children)$/]",
        "message": "<SearchPill> doesn't accept that prop. Declared props: placeholder, value, onChange, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubNavStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:breadcrumb|sort|filtersHidden|onToggleFilters|style|key|ref|className|style|children)$/]",
        "message": "<SubNavStrip> doesn't accept that prop. Declared props: breadcrumb, sort, filtersHidden, onToggleFilters, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwatchDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|active|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SwatchDot> doesn't accept that prop. Declared props: color, active, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UtilityBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|left|style|key|ref|className|style|children)$/]",
        "message": "<UtilityBar> doesn't accept that prop. Declared props: links, left, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
